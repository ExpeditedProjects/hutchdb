{
  "name": "hutch-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3111",
    "build": "npx tsx scripts/migrate.ts && next build",
    "build:app": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "npx drizzle-kit generate",
    "db:migrate": "npx drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npx tsx scripts/smoke.ts",
    "storage:cutover": "npx tsx scripts/storage-cutover.ts",
    "storage:build-indexes": "npx tsx scripts/storage-build-indexes.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "drizzle-orm": "^0.45.4",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
